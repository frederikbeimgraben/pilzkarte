{
  "name": "pilzkarte",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch --coverage",
    "lint": "eslint . && npm run check:identifiers && npm run check:templates && npm run check:frames && npm run check:comments && npm run check:size && npm run check:selectors && npm run check:german && npm run format:check",
    "check:identifiers": "node tools/check-identifiers.mjs",
    "check:templates": "node tools/check-templates.mjs",
    "check:frames": "node tools/check-frames.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "check:comments": "node tools/check-comments.mjs",
    "check:size": "node tools/check-size.mjs",
    "check:selectors": "node tools/check-selectors.mjs",
    "check:german": "node tools/check-german.mjs",
    "boards:render": "node tools/render-boards.mjs",
    "boards:sync": "node tools/sync-boards.mjs",
    "texts:sync": "node tools/sync-texts.mjs",
    "api:generate": "openapi-typescript ../backend/openapi.yaml -o src/app/core/api/contract.d.ts",
    "e2e": "playwright test",
    "e2e:boards": "node tools/check-boards.mjs && playwright test --project=phone --project=desktop --project=wide --project=blocks",
    "e2e:flows": "playwright test --project=flows",
    "lighthouse": "lhci autorun",
    "boards:cards": "node tools/measure-blocks-cards.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@angular/service-worker": "22.1.6",
    "@stupa-makers/ui-kit": "file:vendor/stupa-makers-ui-kit-0.1.2.tgz",
    "@turf/area": "^7.4.0",
    "idb": "^8.0.3",
    "maplibre-gl": "^6.9.0",
    "oidc-client-ts": "^3.5.0",
    "rxjs": "~7.8.0",
    "terra-draw": "^1.33.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@eslint/js": "^9.39.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^4.0.8",
    "angular-eslint": "^22.5.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@stupa-makers/ui-kit": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/forms": "$@angular/forms"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
