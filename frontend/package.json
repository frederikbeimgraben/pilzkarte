{
  "name": "pilzkarte",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch --coverage",
    "lint": "eslint . && npm run check:identifiers && npm run check:templates && npm run format:check",
    "check:identifiers": "node tools/check-identifiers.mjs",
    "check:templates": "node tools/check-templates.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@stupa-makers/ui-kit": "file:vendor/stupa-makers-ui-kit-0.1.0.tgz",
    "@turf/area": "^7.4.0",
    "idb": "^8.0.3",
    "maplibre-gl": "^6.9.0",
    "oidc-client-ts": "^3.5.0",
    "rxjs": "~7.8.0",
    "terra-draw": "^1.33.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^9.39.0",
    "@testing-library/angular": "^19.4.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^4.0.8",
    "angular-eslint": "^22.5.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@stupa-makers/ui-kit": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/forms": "$@angular/forms"
    }
  }
}
