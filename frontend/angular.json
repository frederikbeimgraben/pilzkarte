{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "pilzkarte": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "node_modules/@stupa-makers/ui-kit/assets/fonts",
                "output": "assets/fonts"
              },
              {
                "glob": "maplibre-gl-{worker,shared}.mjs",
                "input": "node_modules/maplibre-gl/dist",
                "output": "assets/maplibre"
              }
            ],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "production": {
              "budgets": [
                // 650 kB statt 600 sind ein Übergang, kein neues Maß. Der
                // i18n-Katalog liegt mit beiden Sprachen fest im ersten
                // Bündel, obwohl G2 die Texte von `GET /api/texts` holt: tote
                // Fracht, kein Wachstum. Karte 80 räumt sie weg, dann geht die
                // Schwelle zurück.
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "650kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "pilzkarte:build:production"
            },
            "development": {
              "buildTarget": "pilzkarte:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest",
            "tsConfig": "tsconfig.spec.json",
            "setupFiles": ["src/test-setup.ts"],
            "coverage": true,
            "coverageInclude": ["src/app/**/*.ts"],
            "coverageExclude": ["src/app/**/*.spec.ts", "src/app/testing/**"],
            "coverageReporters": ["text-summary", "lcovonly"],
            "coverageThresholds": {
              "lines": 90,
              "branches": 90
            },
            "isolate": true
          }
        }
      }
    }
  }
}
