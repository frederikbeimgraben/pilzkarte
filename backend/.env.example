# Vorgaben fuer die Entwicklung. Kopieren nach .env und anpassen.
# Die Bedeutung jeder Variablen steht in docs/betrieb.md.
PILZE_DB=sqlite+aiosqlite:///./var/pilze.sqlite
PILZE_FOTOS=./var/fotos
PILZE_MAPS=./var/maps
PILZE_OIDC_ISSUER=https://sso.beimgraben.net/application/o/pilze/
PILZE_OIDC_CLIENT_ID=pilze
PILZE_ORIGIN=http://localhost:4200
